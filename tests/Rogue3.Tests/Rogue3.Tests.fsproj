<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Feature 060 (FR-005): durable model-agnostic governance scans compile first and
         survive a scaffold-model swap; replaceable scaffold-behavior tests compile after. -->
    <Compile Include="GovernanceTests.fs" />
    <!-- Issue #994: the scaffold-emitted visual-COVERAGE gate — reads the rogue3's element->visual
         catalog (element-visuals.catalog) and reds when a declared gameplay element has no token and
         no reasoned Hidden opt-out. Durable like GovernanceTests (it reads the catalog artifact, not
         the rogue3's model/view), and game-profile-only inside (`//#if profile == "game"`), so it
         compiles to an empty module and adds nothing on the other profiles. -->
    <Compile Include="CoverageGateTests.fs" />
    <Compile Include="BehaviorTests.fs" />
    <Compile Include="InputTests.fs" />
    <Compile Include="M2MovementShotTests.fs" />
    <Compile Include="M3CombatHealthCurrencyTests.fs" />
    <Compile Include="M4ProceduralFloorTests.fs" />
    <Compile Include="M5EntitiesBossRoomsTests.fs" />
    <Compile Include="M6RenderingEnemySymbologyTests.fs" />
    <!-- Issue #1002 (child of #991): release-lane BEHAVIOUR coverage for the generic game shell.
         Drives GameShell.fs's pure `update` + host-free seams (router, Esc routing, rebind capture,
         display->window-behaviour mapping, keymap persistence). Additive — it adds shell tests beside
         the durable GovernanceTests and the replaceable BehaviorTests without touching either. The
         shell module is emitted on `app`/`game` only, so the file body is `//#if (profile == "app" ||
         profile == "game")` and compiles to an empty module on the other profiles (the CoverageGateTests
         pattern), which is why it needs no compile Condition here. -->
    <Compile Include="ShellBehaviorTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rogue3\Rogue3.fsproj" />
    <!-- Issue #432 (finishing #90): the fs-gg-testing skill materializes on every profile and tells the
         author to `open FS.GG.UI.Testing`. The reference belongs here rather than in src/: the assertion,
         evidence-report and layout-validation helpers it documents are consumed from the test project —
         BehaviorTests.fs already calls one of them — and no source under src/ uses them. (Their type names
         are not spelled out here: they embed the substitution token, and #282's guard would mangle them.) -->
    <PackageReference Include="FS.GG.UI.Testing" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
